{
  "name": "bitterblossom-net",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  // only the homepage and the last played cover run the worker; everything else is served as a plain file
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/art/*"]
  },
  // every minute: ask navidrome what's playing (see worker/index.js)
  "triggers": {
    "crons": ["* * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "TRACKS",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "NAVIDROME_URL": "https://mu.bitterblossom.net",
    "LISTENER": "madeline"
  }
}
